<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#121212">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="БЫСТРЫЙ ДОСТУП"
        android:textColor="#E53935" android:textStyle="bold" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/widget_tv" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center"
            android:text="ТЕЛЕВИЗОР" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#232323" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_radio" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center"
            android:text="РАДИО" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#E53935" />
    </LinearLayout>
</LinearLayout>
