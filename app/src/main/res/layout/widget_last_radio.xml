<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_last_radio_art"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/start_radio_cd"
        android:contentDescription="Радио" />

    <TextView
        android:id="@+id/widget_last_radio_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Последнее радио"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/widget_last_radio_toggle"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_widget_play"
        android:contentDescription="Пауза / Пуск" />
</LinearLayout>
