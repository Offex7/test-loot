<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#121212">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ПОСЛЕДНЕЕ РАДИО" android:textColor="#E53935" android:textStyle="bold" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/widget_logo" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop" />
        <TextView android:id="@+id/widget_station" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_play" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center"
            android:text="▶" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#E53935" />
    </LinearLayout>
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center"
        android:text="ОТКРЫТЬ РАДИО" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#232323" />
</LinearLayout>
